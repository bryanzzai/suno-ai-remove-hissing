<Window x:Class="SunoAiRemoveHissing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suno AI Remove Hissing" Height="900" Width="1180" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Suno AI Remove Hissing" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                       Text="Local Windows whole-mix artifact reduction. Originals are never modified." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Input folder" />
            <TextBox x:Name="InputPathTextBox" Grid.Column="1" MinHeight="32" Margin="0,0,8,5" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Padding="16,6" Margin="0,0,0,5" Content="Browse…" Click="BrowseInput_Click" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Output folder" />
            <TextBox x:Name="OutputPathTextBox" Grid.Row="1" Grid.Column="1" MinHeight="32" Margin="0,0,8,5" VerticalContentAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="2" Padding="16,6" Margin="0,0,0,5" Content="Browse…" Click="BrowseOutput_Click" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="python.exe" />
            <TextBox x:Name="PythonPathTextBox" Grid.Row="2" Grid.Column="1" MinHeight="32" Margin="0,0,8,0" VerticalContentAlignment="Center" />
            <Button Grid.Row="2" Grid.Column="2" Padding="16,6" Content="Browse…" Click="BrowsePython_Click" />
        </Grid>

        <GroupBox Grid.Row="2" Header="Whole-mix effects" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Dynamic 1.8–4 kHz" />
                <Slider x:Name="DynamicProfileSlider" Grid.Column="1" Minimum="0" Maximum="4" Value="2" TickFrequency="1"
                        IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="DynamicProfileSlider_ValueChanged" />
                <TextBlock x:Name="DynamicProfileTextBlock" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="Normal" />
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Harmonic de-fizzer" />
                <Slider x:Name="HarmonicProfileSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="4" Value="2" TickFrequency="1"
                        IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="HarmonicProfileSlider_ValueChanged" />
                <TextBlock x:Name="HarmonicProfileTextBlock" Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="Normal" />
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="OverwriteCheckBox" VerticalAlignment="Center" Content="Replace existing output files" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Output format" />
                        <RadioButton x:Name="WavOutputRadioButton" GroupName="OutputFormat" IsChecked="True" Content="WAV" Margin="0,0,12,0" />
                        <RadioButton x:Name="M4aOutputRadioButton" GroupName="OutputFormat" Content="M4A" />
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="AudioGrid" Grid.Row="3" ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Use" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Audio file" Binding="{Binding FileName}" Width="3*" IsReadOnly="True" />
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" IsReadOnly="True" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock" Text="Choose an input folder, then scan." />
                <ProgressBar x:Name="ProgressBar" Margin="0,6,12,0" Height="7" Minimum="0" Maximum="1" Value="0" />
            </StackPanel>
            <TextBlock x:Name="CountTextBlock" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Foreground="DimGray" Text="0 files" />
            <Button x:Name="ScanButton" Grid.Column="2" Padding="16,6" Margin="0,0,8,0" Content="Scan" Click="ScanButton_Click" />
            <Button x:Name="RunButton" Grid.Column="3" Padding="16,6" Margin="0,0,8,0" Content="Clean audio" Click="RunButton_Click" />
            <Button x:Name="CancelButton" Grid.Column="4" Padding="16,6" Content="Cancel" IsEnabled="False" Click="CancelButton_Click" />
        </Grid>
    </Grid>
</Window>
