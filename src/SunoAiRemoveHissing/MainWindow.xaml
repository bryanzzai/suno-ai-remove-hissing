<Window x:Class="SunoAiRemoveHissing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suno AI Remove Hissing" Height="900" Width="1180" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Suno AI Remove Hissing" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                       Text="Local Windows batch processing: Demucs vocal separation plus conservative high-frequency artifact reduction. Originals are never modified." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Input folder" />
            <TextBox x:Name="InputPathTextBox" Grid.Column="1" MinHeight="32" Margin="0,0,8,5" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Padding="16,6" Margin="0,0,0,5" Content="Browse…" Click="BrowseInput_Click" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Output folder" />
            <TextBox x:Name="OutputPathTextBox" Grid.Row="1" Grid.Column="1" MinHeight="32" Margin="0,0,8,5" VerticalContentAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="2" Padding="16,6" Margin="0,0,0,5" Content="Browse…" Click="BrowseOutput_Click" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="python.exe" />
            <TextBox x:Name="PythonPathTextBox" Grid.Row="2" Grid.Column="1" MinHeight="32" Margin="0,0,8,0" VerticalContentAlignment="Center" />
            <Button Grid.Row="2" Grid.Column="2" Padding="16,6" Content="Browse…" Click="BrowsePython_Click" />
        </Grid>

        <GroupBox Grid.Row="2" Header="Repair settings" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Strength (1–6)" />
                <TextBox x:Name="StrengthTextBox" Grid.Column="1" Text="3" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0" Text="Blend (0–1)" />
                <TextBox x:Name="BlendTextBox" Grid.Column="3" Text="0.75" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="18,0,0,0" Text="GPU segment (1–7 sec)" />
                <TextBox x:Name="SegmentTextBox" Grid.Column="5" Text="7" VerticalContentAlignment="Center" />
                <CheckBox x:Name="OverwriteCheckBox" Grid.Column="6" Margin="18,0,0,0" VerticalAlignment="Center" Content="Replace existing cleaned files" />
                <CheckBox x:Name="TinCanTestCheckBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,12,0,0"
                          Content="Raw tin-can test: apply -3 dB at 1.8–2.2 kHz and -1.5 dB at 2.2–4.0 kHz to accompaniment only. Vocal cleaning is skipped." />
            </Grid>
        </GroupBox>

        <DataGrid x:Name="AudioGrid" Grid.Row="3" ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Audio file" Binding="{Binding FileName}" Width="3*" />
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock" Text="Choose an input folder, then scan." />
                <ProgressBar x:Name="ProgressBar" Margin="0,6,12,0" Height="7" Minimum="0" Maximum="1" Value="0" />
            </StackPanel>
            <TextBlock x:Name="CountTextBlock" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Foreground="DimGray" Text="0 files" />
            <Button x:Name="ScanButton" Grid.Column="2" Padding="16,6" Margin="0,0,8,0" Content="Scan" Click="ScanButton_Click" />
            <Button x:Name="RunButton" Grid.Column="3" Padding="16,6" Margin="0,0,8,0" Content="Clean audio" Click="RunButton_Click" />
            <Button x:Name="CancelButton" Grid.Column="4" Padding="16,6" Content="Cancel" IsEnabled="False" Click="CancelButton_Click" />
        </Grid>
    </Grid>
</Window>
